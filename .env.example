# Aquest fitxer és opcional en local.
# Copia'l a .env o .env.local només si vols sobreescriure els valors per defecte.

# Port local del runtime de Pages Functions/D1.
PORT=8788

# Port preferit del client Vite.
VITE_PORT=5173

# Deixa'l buit per fer servir rutes relatives /api.
VITE_API_BASE_URL=

# URL pública usada a la build per a metadades socials.
VITE_SITE_URL=https://inter2026.tenimaleta.com
